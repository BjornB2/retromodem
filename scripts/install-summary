#!/bin/sh
set -eu
reboot_required=${1:?reboot flag required}
admin_user=${2:?administrator required}
printf '\nSSH: use your existing account %s with your own password/key.\n' "$admin_user"
case "$reboot_required" in
    1)
        printf '\n============================================================\n'
        printf '  INSTALLATION COMPLETE — REBOOT THE RASPBERRY PI NOW\n'
        printf '============================================================\n\n'
        printf 'Run this first:\n\n    sudo reboot\n\n'
        printf 'Log in again AFTER THE REBOOT. Only then run:\n'
        ;;
    0) printf '\nInstallation check:\n' ;;
    *) echo 'Invalid reboot flag' >&2; exit 2 ;;
esac
printf '\n    sudo retromodem-diagnose\n    sudo retromodem-verify\n'

addresses=$(/usr/bin/hostname -I 2>/dev/null || true)
if [ -t 1 ]; then
    accent='\033[1;36m'
    reset='\033[0m'
else
    accent=''
    reset=''
fi
printf '\n%bNEXT: open http://retromodem.local/ in a modern browser.%b\n' "$accent" "$reset"
if [ -n "$addresses" ]; then
    printf 'If the local name is not available yet, try one of these addresses:\n'
    for address in $addresses; do
        case "$address" in
            *:*) ;;
            *) printf '    http://%s/\n' "$address" ;;
        esac
    done
fi
