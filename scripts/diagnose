#!/bin/sh
set -u

# Alternate config path is useful for non-hardware diagnostic regression tests.
config_file=${RETROMODEM_CONFIG:-/etc/retromodem/retromodem.env}
if [ -r "$config_file" ]; then
    . "$config_file"
fi

usb_present() { lsusb -d "$1" 2>/dev/null | grep -q .; }

say_status() {
    label=$1
    shift
    if "$@" >/dev/null 2>&1; then
        printf '[OK]   %s\n' "$label"
    else
        printf '[FAIL] %s\n' "$label"
    fi
}

printf 'RetroModem diagnostics\n'
printf 'Model:  '; tr -d '\000' </proc/device-tree/model 2>/dev/null || printf 'unknown'
printf '\nKernel: %s\n\n' "$(uname -r)"

if command -v vcgencmd >/dev/null 2>&1; then
    throttle_text=$(vcgencmd get_throttled 2>/dev/null || true)
    case $throttle_text in
        throttled=0x*)
            throttle_hex=${throttle_text#throttled=}
            throttle_value=$((throttle_hex))
            if [ $((throttle_value & 0x5)) -ne 0 ]; then
                printf '[FAIL] Current undervoltage or throttling (%s)\n' "$throttle_text"
            elif [ $((throttle_value & 0x50000)) -ne 0 ]; then
                printf '[WARN] Undervoltage or throttling was detected since the last boot (%s)\n' "$throttle_text"
            else
                printf '[OK]   Power supply stable (%s)\n' "$throttle_text"
            fi
            ;;
        *) printf '[WARN] Power status could not be read\n' ;;
    esac
fi

printf 'Selected path: %s over %s\n' "${RETROMODEM_LINE_MODE:-ppp}" "${RETROMODEM_TRANSPORT:-irda}"
if [ "${RETROMODEM_TRANSPORT:-irda}" = serial ]; then
    say_status 'Selected Prolific RS-232 adapter found' usb_present "${RETROMODEM_SERIAL_USB_ID:-067b:2303}"
    printf '[INFO] IrDA and the MA-620 fallback are not required for the serial path.\n'
else
    case ${RETROMODEM_ADAPTER:-ming-yuan-my018} in
        ming-yuan-my018)
            printf '[INFO] MY018 over GPIO/UART is the selected infrared setup.\n'
            say_status 'MY018 uses the PL011 UART' sh -c '[ "$(readlink -f /dev/serial0)" = /dev/ttyAMA0 ]'
            if [ "${RETROMODEM_MY018_POWER_CYCLE:-0}" = 1 ]; then
                say_status 'MY018 power switching active' sh -c '[ "$(cat /sys/module/irtty_sir/parameters/my018_power_cycle 2>/dev/null)" = Y ]'
            fi
            if usb_present 0df7:0620; then
                printf '[INFO] MA-620 connected as an available infrared fallback.\n'
            else
                printf '[INFO] MA-620 fallback not connected; it is not required for MY018.\n'
            fi
            ;;
        mobile-action-ma620)
            say_status 'Selected MA-620 infrared fallback found' usb_present 0df7:0620
            ;;
        *) printf '[FAIL] Unknown infrared adapter: %s\n' "$RETROMODEM_ADAPTER" ;;
    esac
    say_status 'IrDA kernel module available' modinfo irda
    say_status 'IrCOMM device present' test -c /dev/ircomm0
    say_status 'IrDA service active' systemctl is-active --quiet retromodem-irda.service
fi
say_status 'IPv4 forwarding enabled' sh -c 'test "$(cat /proc/sys/net/ipv4/ip_forward)" = 1'
say_status 'NAT rule loaded' nft list table ip retromodem_nat
say_status 'ChatGPT BBS service active' systemctl is-active --quiet retromodem-chatgpt.service
case ${RETROMODEM_LINE_MODE:-ppp} in
    ppp) selected_service=retromodem-ppp.service ;;
    dialup) selected_service=retromodem-tcpser.service ;;
    *) selected_service=unknown ;;
esac
[ "$selected_service" = unknown ] || say_status "Selected service active ($selected_service)" systemctl is-active --quiet "$selected_service"

printf '\nInterfaces:\n'
ip -brief address show 2>/dev/null || true
printf '\nRecent service messages:\n'
journalctl -u retromodem-irda.service -u retromodem-ppp.service -n 20 --no-pager 2>/dev/null || true
