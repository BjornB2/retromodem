--- a/src/serial.c
+++ b/src/serial.c
@@ -127,12 +127,16 @@ int ser_set_flow_control(int fd, int status) {
     ELOG(LOG_FATAL, "Could not get serial port attributes");
     return -1;
   }
-  // turn all off.
-  tio.c_cflag &= ~(IXON | IXOFF | CRTSCTS);
-  tio.c_cflag |= status;
+  /* Software flow-control bits belong to c_iflag, not c_cflag.
+     On Linux IXOFF overlaps CBAUDEX: clearing it in c_cflag silently
+     changes B115200 to B75 (and B57600 to B50). */
+  tio.c_iflag &= ~(IXON | IXOFF);
+  tio.c_iflag |= status & (IXON | IXOFF);
+  tio.c_cflag &= ~CRTSCTS;
+  tio.c_cflag |= status & CRTSCTS;
   if(0 != tcsetattr(fd, TCSANOW, &tio)) {
     ELOG(LOG_FATAL,"Could not set serial port attributes");
     return -1;
   }
   return 0;
 }
