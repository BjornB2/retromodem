[Unit]
Description=RetroModem ChatGPT BBS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/retromodem/retromodem.env
ExecStart=/usr/bin/python3 /usr/local/lib/retromodem/chatgpt-bbs.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/retromodem/chatgpt

[Install]
WantedBy=multi-user.target
