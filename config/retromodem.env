RETROMODEM_ADAPTER=ming-yuan-my018
RETROMODEM_USB_ID=0df7:0620
RETROMODEM_TTY=/dev/serial0
RETROMODEM_DEVICE=/run/retromodem/tty
RETROMODEM_DONGLE=''
# Safe template until the installer confirms the modified MY018 wiring.
# The confirmed fresh MY018 installation uses 57600.
RETROMODEM_IRDA_BITRATE=9600
RETROMODEM_MY018_BITRATE=9600
RETROMODEM_MY018_DIALUP_BITRATE=115200
RETROMODEM_MA620_BITRATE=9600
RETROMODEM_MA620_DIALUP_BITRATE=115200
RETROMODEM_IRDA_DIALUP_BITRATE=115200
# Installer enables this only after confirming the documented wiring.
RETROMODEM_MY018_POWER_CYCLE=0
# IrLAP compatibility ceilings. Keep protocol defaults unless a traced adapter
# interoperability problem requires a smaller frame/window.
RETROMODEM_IRDA_MAX_TX_DATA_SIZE=2042
RETROMODEM_IRDA_MAX_TX_WINDOW=7
RETROMODEM_PPP_LOCAL=192.168.77.1
RETROMODEM_PPP_REMOTE=192.168.77.2
RETROMODEM_WIFI_INTERFACE=wlan0
RETROMODEM_WIFI_FALLBACK_SECONDS=10
RETROMODEM_WIFI_CHECK_SECONDS=5
RETROMODEM_AP_SSID=retromodem
RETROMODEM_AP_PASSWORD=12345678
RETROMODEM_WEB_PASSWORD=retromodem
RETROMODEM_PROXY_MODE=manual
RETROMODEM_PROXY_EXCEPTIONS=retroweb.bjrno.com,frogfind.com,theoldnet.com,68k.news
RETROMODEM_PROXY_PAGE_SIZE=18000
RETROMODEM_PROXY_PAGE_IMAGES=5
RETROMODEM_PROXY_IMAGE_MODE=inline
RETROMODEM_PROXY_IMAGE_WIDTH=200
RETROMODEM_PROXY_IMAGE_HEIGHT=150
RETROMODEM_LANGUAGE=nl
RETROMODEM_CHATGPT_CONTINUE=0
RETROMODEM_CHATGPT_AGENT=0
RETROMODEM_TRANSPORT=irda
RETROMODEM_LINE_MODE=ppp
RETROMODEM_SERIAL_USB_ID=067b:2303
RETROMODEM_SERIAL_BITRATE=115200
RETROMODEM_SERIAL_DIALUP_BITRATE=115200
RETROMODEM_GPIO_BUTTON=16
RETROMODEM_BUTTON_HOLD_SECONDS=3.0
RETROMODEM_GPIO_LED_DIALUP=23
RETROMODEM_GPIO_LED_PPP=24
